# Copy this file to .env for local development (never commit .env)

# Flask secret key — any long random string, e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# SQLite DB path — leave blank to use ./data/sanctions.db (default for local dev)
# On Render this is set to /data/sanctions.db automatically via render.yaml
# DB_PATH=/data/sanctions.db

# Resend email (https://resend.com — free tier: 3,000 emails/month)
# Leave blank to use dev mode (reset links printed to terminal instead)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SanctionsIQ <noreply@yourdomain.com>
